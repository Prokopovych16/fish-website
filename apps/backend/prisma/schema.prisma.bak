// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  USER
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD_ONLINE
  CASH_ON_DELIVERY
  LIQPAY
  FONDY
}

enum DeliveryMethod {
  NOVA_POSHTA_BRANCH
  NOVA_POSHTA_COURIER
  PICKUP
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  GIFT_PRODUCT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  phone           String?
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatar          String?
  role            Role    @default(USER)
  isEmailVerified Boolean @default(false)
  isBlocked       Boolean @default(false)
  blockReason     String?
  loyaltyPoints   Int     @default(0)
  totalSpent      Decimal @default(0) @db.Decimal(10, 2)

  googleId   String? @unique
  facebookId String? @unique

  refreshTokens        RefreshToken[]
  passwordResetToken   String?
  passwordResetExpires DateTime?
  emailVerifyToken     String?

  orders         Order[]
  reviews        Review[]
  wishlist       WishlistItem[]
  cart           CartItem[]
  addresses      Address[]
  loyaltyHistory LoyaltyHistory[]
  adminLogs      AdminLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?
  city         String
  npCityRef    String?
  npBranchRef  String?
  npBranchName String?
  street       String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─── CATEGORIES ──────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── PRODUCTS ────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])

  price           Decimal  @db.Decimal(10, 2)
  oldPrice        Decimal? @db.Decimal(10, 2)
  discountPercent Int?

  stock Int     @default(0)
  sku   String? @unique
  unit  String  @default("кг")

  images ProductImage[]

  weight            Decimal? @db.Decimal(8, 3)
  origin            String?
  catchMethod       String?
  storageConditions String?
  expiryDays        Int?
  composition       String?  @db.Text
  calories          Decimal? @db.Decimal(6, 2)
  proteins          Decimal? @db.Decimal(6, 2)
  fats              Decimal? @db.Decimal(6, 2)
  carbs             Decimal? @db.Decimal(6, 2)
  isHaccp           Boolean  @default(true)

  tags   ProductTag[]
  badges String[]     @default([])

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  bundleProducts BundleProduct[] @relation("BundleMain")
  bundleItems    BundleProduct[] @relation("BundleItems")

  viewCount Int @default(0)
  soldCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// Набори / бандли
model Bundle {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  image       String?
  price       Decimal         @db.Decimal(10, 2)
  oldPrice    Decimal?        @db.Decimal(10, 2)
  isActive    Boolean         @default(true)
  products    BundleProduct[]
  createdAt   DateTime        @default(now())
}

model BundleProduct {
  bundleId  String
  productId String
  quantity  Int     @default(1)
  bundle    Bundle  @relation(fields: [bundleId], references: [id])
  product   Product @relation("BundleItems", fields: [productId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([bundleId, productId])
}

// ─── REVIEWS ─────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName   String
  authorCity   String?
  authorAvatar String?
  rating       Int
  title        String?
  text         String       @db.Text
  images       String[]     @default([])
  isVerified   Boolean      @default(false)
  isFake       Boolean      @default(false)
  status       ReviewStatus @default(PENDING)
  adminNote    String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── ORDERS ──────────────────────────────────────────────

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactFirstName String
  contactLastName  String
  contactPhone     String
  contactEmail     String

  deliveryMethod   DeliveryMethod
  npCityName       String?
  npBranchName     String?
  npBranchRef      String?
  npTrackingNumber String?
  deliveryAddress  String?
  deliveryCost     Decimal        @default(0) @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?

  discountCode      String?
  discountAmount    Decimal @default(0) @db.Decimal(10, 2)
  loyaltyPointsUsed Int     @default(0)

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  status    OrderStatus @default(PENDING)
  adminNote String?

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  emailSentAt DateTime?
  smsSentAt   DateTime?

  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  total        Decimal  @db.Decimal(10, 2)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())
}

// ─── CART ────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── WISHLIST ────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── DISCOUNTS ───────────────────────────────────────────

model Discount {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  type            DiscountType
  value           Decimal      @db.Decimal(10, 2)
  minOrderAmount  Decimal?     @db.Decimal(10, 2)
  maxUsageCount   Int?
  usageCount      Int          @default(0)
  maxUsagePerUser Int          @default(1)
  isActive        Boolean      @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  productIds      String[]     @default([])
  categoryIds     String[]     @default([])
  createdAt       DateTime     @default(now())
}

// Флеш-розпродаж
model FlashSale {
  id        String             @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean            @default(true)
  products  FlashSaleProduct[]
  createdAt DateTime           @default(now())
}

model FlashSaleProduct {
  flashSaleId String
  productId   String
  salePrice   Decimal   @db.Decimal(10, 2)
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  @@id([flashSaleId, productId])
}

// ─── LOYALTY ─────────────────────────────────────────────

model LoyaltyHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  description String
  orderId     String?
  createdAt   DateTime @default(now())
}

// ─── CONTENT ─────────────────────────────────────────────

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  buttonText  String?
  buttonLink  String?
  image       String
  imageMobile String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
}

model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String     @db.Text
  image          String?
  authorName     String     @default("Команда ФОП Валігура")
  status         BlogStatus @default(DRAFT)
  tags           String[]   @default([])
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── SETTINGS ────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

// ─── ADMIN ───────────────────────────────────────────────

model AdminLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
}

model Popup {
  id              String   @id @default(cuid())
  title           String
  content         String
  image           String?
  buttonText      String?
  buttonLink      String?
  delay           Int      @default(3)
  showAfterScroll Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}
