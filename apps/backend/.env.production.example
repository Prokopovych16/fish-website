# =============================================================
# PRODUCTION .env для apps/backend
# Скопіювати в .env і заповнити всі значення
# =============================================================

# --- База даних ---
DATABASE_URL="postgresql://fish_user:STRONG_DB_PASSWORD@localhost:5432/fish_shop"

# --- JWT (обов'язково змінити на довгі випадкові рядки!) ---
# Генерувати: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_64_RANDOM_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_64_RANDOM_CHARS_DIFFERENT"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# --- Redis ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Завантаження файлів ---
# Абсолютний шлях до папки uploads на сервері
UPLOADS_DIR="/var/www/fish-shop/apps/backend/uploads"
# Публічний URL — nginx роздає /uploads/ напряму
UPLOADS_URL="https://YOUR_DOMAIN/uploads"

# --- Email (Gmail App Password) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="valigura.fish@gmail.com"
SMTP_PASS="GMAIL_APP_PASSWORD_16_CHARS"
SMTP_FROM="ФОП Валігура <valigura.fish@gmail.com>"

# --- Зовнішні сервіси ---
NOVA_POSHTA_API_KEY="YOUR_NOVA_POSHTA_KEY"

DEFAULT_PAYMENT_PROVIDER="wayforpay"
WAYFORPAY_MERCHANT_ACCOUNT="YOUR_MERCHANT_ACCOUNT"
WAYFORPAY_MERCHANT_SECRET_KEY="YOUR_MERCHANT_SECRET"
WAYFORPAY_MERCHANT_DOMAIN="YOUR_DOMAIN"

LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""

# --- URLs ---
FRONTEND_URL="https://YOUR_DOMAIN"
BACKEND_URL="https://YOUR_DOMAIN"
PORT="4000"

NODE_ENV="production"
