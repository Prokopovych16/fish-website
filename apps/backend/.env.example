# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fish_shop"

# JWT
JWT_ACCESS_SECRET="your_access_secret_key_change_this_in_production"
JWT_REFRESH_SECRET="your_refresh_secret_key_change_this_in_production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# Redis
REDIS_URL="redis://localhost:6379"

# File Upload
UPLOADS_DIR="./uploads"
UPLOADS_URL="http://localhost:4000/uploads"

# Email (Nodemailer/SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@fish-shop.ua"

# OR Resend Email Service (alternative)
RESEND_API_KEY=""

# External Services
# Можна вставити ключі тут АБО через адмінку (Налаштування → Доставка/Платежі) —
# значення з адмінки (БД) має пріоритет над цими змінними середовища.
NOVA_POSHTA_API_KEY=""

# Платіжні провайдери — система підтримує декілька, активний обирається в
# адмінці (Налаштування → Платежі) або через DEFAULT_PAYMENT_PROVIDER нижче.
DEFAULT_PAYMENT_PROVIDER="wayforpay"

# WayForPay (основний провайдер за замовчуванням) — https://wayforpay.com/account
WAYFORPAY_MERCHANT_ACCOUNT=""
WAYFORPAY_MERCHANT_SECRET_KEY=""
WAYFORPAY_MERCHANT_DOMAIN=""

# LiqPay (альтернативний провайдер)
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""

# Frontend URL
FRONTEND_URL="http://localhost:3000"
# Публічний URL бекенду — використовується для callback-вебхуків платіжних провайдерів.
# У продакшені обов'язково вкажіть реальний публічний домен (провайдер має достукатися до нього).
BACKEND_URL="http://localhost:4000"
PORT="4000"
