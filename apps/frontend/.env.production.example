# =============================================================
# PRODUCTION .env.local для apps/frontend
# Скопіювати в .env.local і заповнити перед npm run build
# ВАЖЛИВО: NEXT_PUBLIC_* вбудовуються в JS під час збірки —
#          встанови ці змінні ДО запуску npm run build
# =============================================================

# URL бекенду — nginx проксує /api/ → port 4000
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api

# URL сайту
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN

# Аналітика (заповнювати після налаштування в адмінці — опціонально)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
